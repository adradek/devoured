<%= turbo_frame_tag(dom_id(reading)) do %>
  <% if reading.progress_bars? %>
    <%# A reading with progress: Bootstrap accordion, the progress bars are in the collapsible part %>
    <% collapse_id = "progress_#{dom_id(reading)}" %>
    <div class="accordion mb-1 reading-accordion">
      <%= tag.div class: ["accordion-item reading", *reading.labels] do %>
        <div class="accordion-header">
          <%= render "users/books/reading_row", reading: reading, collapse_id: collapse_id %>
        </div>
        <%= tag.div id: collapse_id, class: "accordion-collapse collapse" do %>
          <div class="accordion-body">
            <%= render "users/books/reading_progress", reading: reading %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= tag.div class: ["card mb-1 reading", *reading.labels] do %>
      <div class="card-body">
        <%= render "users/books/reading_row", reading: reading %>
      </div>
    <% end %>
  <% end %>
<% end %>
