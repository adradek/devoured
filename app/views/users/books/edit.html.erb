<%= turbo_frame_tag(dom_id(@reading)) do %>
  <div class="card mb-1">
    <div class="card-body">
      <%= form_with url: user_book_path(@user, @reading), method: :put do %>
        <div class="mb-3 text-truncate fw-semibold"><%= @reading.book.caption %></div>

        <div class="row g-2 mb-3 align-items-center" data-controller="swap">
          <div class="col-auto">
            <%= date_field_tag :start, @reading.start, id: "start_#{@reading.id}",
                  class: "form-control", data: { swap_target: "left" } %>
          </div>
          <div class="col-auto">
            <%= button_tag "<->", type: "button", class: "btn btn-outline-secondary", data: { action: "swap#execute" } %>
          </div>
          <div class="col-auto">
            <%= date_field_tag :finish, @reading.finish, id: "finish_#{@reading.id}",
                  class: "form-control", data: { swap_target: "right" } %>
          </div>
        </div>

        <div class="row g-2 mb-3 align-items-center">
          <div class="col-auto">
            <%= label_tag "total_pages_#{@reading.id}", "Страниц в книге", class: "col-form-label" %>
          </div>
          <div class="col-auto">
            <%= number_field_tag :total_pages, @reading.total_pages, id: "total_pages_#{@reading.id}",
                  min: 1, class: "form-control page-input" %>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-auto form-check">
            <%= hidden_field_tag :professional, "0", id: nil %>
            <%= check_box_tag :professional, "1", @reading.professional, id: "professional_#{@reading.id}", class: "form-check-input" %>
            <%= label_tag "professional_#{@reading.id}", "Professional", class: "form-check-label" %>
          </div>
          <div class="col-auto form-check">
            <%= hidden_field_tag :significant, "0", id: nil %>
            <%= check_box_tag :significant, "1", @reading.significant, id: "significant_#{@reading.id}", class: "form-check-input" %>
            <%= label_tag "significant_#{@reading.id}", "Significant", class: "form-check-label" %>
          </div>
        </div>

        <%= submit_tag "Сохранить", class: "btn btn-primary" %>
        <%# Loads the books page into this frame, which brings the reading card back %>
        <%= link_to "Отмена", user_book_path(@user, @reading), class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
  </div>
<% end %>
