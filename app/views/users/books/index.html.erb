<%= render 'shared/navbar_new' %>
<div class="row under-navbar">
  <div class="col-lg-5 offset-lg-2">
    <h2>Прочитано</h2>
    <% if policy(@user).update? %>
      <%= turbo_frame_tag("reading_form") do %>
        <%= render partial: 'form', locals: { book: @book, type: :consumed } %>
      <% end %>
    <% end %>

    <%= render partial: "readings_list", locals: { readings: @readings } %>
  </div>

  <div class="col-3">
    <h2>Прочитать [fixme]</h2>
    <%# FIXME: пофиксить обработку создания книги в контроллере %>
    <% if policy(@user).update? %>
      <%= turbo_frame_tag('reading_intention_form') do %>
        <%= render partial: 'form', locals: { book: @book, type: :to_read } %>
      <% end %>
    <% end %>

    <div class="mt-5">
      <%= turbo_frame_tag('reading_goals') do %>
        <%= render partial: "intention", collection: @intentions, as: :reading_goal %>
      <% end %>
    </div>
  </div>
</div>
